{
    "name": "@eighty4/dank",
    "version": "0.0.5",
    "type": "module",
    "license": "MIT",
    "author": "Adam McKee Bennett <adam.be.g84d@gmail.com>",
    "packageManager": "pnpm@11.18.0",
    "engines": {
        "node": ">=24"
    },
    "description": "Multi-page development system for CDN-deployed websites",
    "keywords": [
        "frontend",
        "bundler",
        "esbuild",
        "dank"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/eighty4/dank"
    },
    "bin": "./lib_js/bin.js",
    "exports": {
        ".": {
            "node": "./lib_js/dank.js",
            "types": "./lib_types/dank.d.ts",
            "import": "./lib/dank.ts"
        }
    },
    "scripts": {
        "build": "pnpm build:client && pnpm build:lib",
        "build:client": "node scripts/build_client.ts",
        "build:lib": "pnpm typecheck:sw && tsc -p tsconfig.lib.json && tsc -p tsconfig.exports.json",
        "build:release": "node scripts/release_prebuild.ts && pnpm build && node scripts/release_postbuild.ts",
        "fmt": "prettier --write . --log-level warn",
        "fmtcheck": "prettier --check .",
        "test": "node --test \"test/**/*.test.ts\"",
        "test:rebuild": "pnpm build && pnpm test",
        "typecheck": "tsc && pnpm typecheck:client && pnpm typecheck:lib && pnpm typecheck:sw",
        "typecheck:client": "tsc -p tsconfig.client.dev.json && tsc -p tsconfig.client.esbuild.json",
        "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
        "typecheck:sw": "tsc -p tsconfig.sw.json"
    },
    "dependencies": {
        "esbuild": "^0.28.1",
        "mime": "^4.1.0",
        "parse5": "^8.0.1",
        "ulid": "^3.0.2"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "prettier": "catalog:",
        "typescript": "catalog:"
    },
    "files": [
        "client/build/*.js",
        "client/ServiceWorker.ts",
        "lib/*.ts",
        "lib_js/*.js",
        "lib_types/*.d.ts"
    ]
}
